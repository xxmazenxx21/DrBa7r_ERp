### =====================================================================
### WEEK 3 - MORE EXAMPLES (after the two big tests; same data)
### =====================================================================
# Run "WEEK 2 - THE BIG TEST" and "WEEK 3 - THE BIG TEST" first (they leave
# Maadi at 145 brushes @ 10.6818 and Nasr City at 24). These samples show the
# lists, filters, error cases and the cancel paths. Every stock change below is
# undone again, so they also END at Maadi 145 / Nasr City 24.
# Request names start with ex3 (the big test uses w3).

### ---------------------------------------------------------------------
### Sales quotations (عروض أسعار البيع)
### ---------------------------------------------------------------------

### Quotations list (paginated; filters customerId, branchId, status, dateFrom, dateTo, search)
GET {{baseUrl}}/sales-quotations?status=CONVERTED&customerId={{w3customer.response.body.$.data.id}}&page=1&pageSize=20
Authorization: Bearer {{w3token}}

### Search = part of the code, the customer name or the notes
GET {{baseUrl}}/sales-quotations?search=SQ-2026
Authorization: Bearer {{w3token}}

### One quotation: SQ-2026-000001, CONVERTED, convertedToInvoiceId = SI-2026-000001's id, isExpired false
GET {{baseUrl}}/sales-quotations/{{w3quotation.response.body.$.data.id}}
Authorization: Bearer {{w3token}}

### Convert it again -> 409 INVALID_STATUS ("This quotation is CONVERTED: ...")
POST {{baseUrl}}/sales-quotations/{{w3quotation.response.body.$.data.id}}/convert-to-invoice
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "paymentType": "CREDIT",
  "invoiceDate": "2026-11-28"
}

### Delete a CONVERTED quotation -> 409 INVALID_STATUS
DELETE {{baseUrl}}/sales-quotations/{{w3quotation.response.body.$.data.id}}
Authorization: Bearer {{w3token}}

### A second quotation, NO warehouse -> SQ-2026-000002 DRAFT, netTotal 205.20
# @name ex3quotation
POST {{baseUrl}}/sales-quotations
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "quotationDate": "2026-11-28",
  "customerId": "{{w3customer.response.body.$.data.id}}",
  "branchId": "{{w2branch.response.body.$.data.id}}",
  "taxPercent": 14,
  "lines": [
    {
      "productId": "{{w2brush.response.body.$.data.id}}",
      "itemUnitId": "{{w2carton.response.body.$.data.id}}",
      "quantity": 1,
      "unitPrice": 180
    }
  ]
}

### DRAFT -> ACCEPTED directly -> 409 INVALID_STATUS
PATCH {{baseUrl}}/sales-quotations/{{ex3quotation.response.body.$.data.id}}/status
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "status": "ACCEPTED"
}

### DRAFT -> SENT
PATCH {{baseUrl}}/sales-quotations/{{ex3quotation.response.body.$.data.id}}/status
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "status": "SENT"
}

### Edit while SENT ("lines" would REPLACE all lines)
PATCH {{baseUrl}}/sales-quotations/{{ex3quotation.response.body.$.data.id}}
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "notes": "السعر شامل التوصيل"
}

### Convert while SENT -> 409 INVALID_STATUS (only ACCEPTED can be converted)
POST {{baseUrl}}/sales-quotations/{{ex3quotation.response.body.$.data.id}}/convert-to-invoice
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "paymentType": "CASH",
  "invoiceDate": "2026-11-28"
}

### SENT -> ACCEPTED
PATCH {{baseUrl}}/sales-quotations/{{ex3quotation.response.body.$.data.id}}/status
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "status": "ACCEPTED"
}

### Convert without warehouseId (the quotation has none) -> 400 VALIDATION_FAILED, field warehouseId
POST {{baseUrl}}/sales-quotations/{{ex3quotation.response.body.$.data.id}}/convert-to-invoice
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "paymentType": "CASH",
  "invoiceDate": "2026-11-28"
}

### Convert with the warehouse (CASH) -> SI-2026-000003 DRAFT (paidAmount = netTotal 205.20); quotation CONVERTED
# (SI-2026-000002 was the deleted invoice of W3-10: a number is never reused)
# @name ex3convert
POST {{baseUrl}}/sales-quotations/{{ex3quotation.response.body.$.data.id}}/convert-to-invoice
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "paymentType": "CASH",
  "invoiceDate": "2026-11-28",
  "warehouseId": "{{w2warehouse.response.body.$.data.id}}"
}

### Delete that DRAFT invoice -> 200; the quotation goes back to ACCEPTED
DELETE {{baseUrl}}/sales-invoices/{{ex3convert.response.body.$.data.invoice.id}}
Authorization: Bearer {{w3token}}

### The quotation again: status ACCEPTED, convertedToInvoiceId null (it can be converted again)
GET {{baseUrl}}/sales-quotations/{{ex3quotation.response.body.$.data.id}}
Authorization: Bearer {{w3token}}

