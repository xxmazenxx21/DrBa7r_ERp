### W3-13 Post the return -> POSTED, totalCost 128.18; Maadi 170 (SALE_RETURN +12 at 10.6818)
# @name w3returnPost
POST {{baseUrl}}/sales-returns/{{w3return.response.body.$.data.id}}/post
Authorization: Bearer {{w3token}}

### W3-14 Cancel SI-2026-000001 -> 400 BAD_REQUEST, field status ("This invoice has 1 POSTED sales return(s): ...")
# @name w3cancelInvoice
POST {{baseUrl}}/sales-invoices/{{w3invoiceId}}/cancel
Authorization: Bearer {{w3token}}

### W3-15 Transfer 2 cartons Maadi -> Nasr City -> ST-2026-000001 DRAFT
# @name w3transfer
POST {{baseUrl}}/stock-transfers
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "transferDate": "2026-11-27",
  "fromWarehouseId": "{{w2warehouse.response.body.$.data.id}}",
  "toWarehouseId": "{{w3nasr.response.body.$.data.id}}",
  "lines": [
    {
      "productId": "{{w2brush.response.body.$.data.id}}",
      "itemUnitId": "{{w2carton.response.body.$.data.id}}",
      "quantity": 2
    }
  ]
}

### W3-16 Post the transfer -> POSTED, totalCost 256.36; Maadi 146 (TRANSFER_OUT -24), Nasr City 24 (TRANSFER_IN +24)
# @name w3transferPost
POST {{baseUrl}}/stock-transfers/{{w3transfer.response.body.$.data.id}}/post
Authorization: Bearer {{w3token}}

