@baseUrl = http://localhost:3000

### 0a. Signup (TEMPORARY - always creates a SUPERADMIN, "role" is ignored)
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "username": "drba7r",
  "password": "drba7r12345",
  "email": "drba7r@example.com"
}

### 0b. Login -> response: { "message": "...", "data": { "access_token", "user": { id, username, role } } }
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "drba7r",
  "password": "drba7r12345"
}

### Every request below needs a SUPERADMIN token (other roles get 403)
@token = {{login.response.body.data.access_token}}

### 1. Create Cairo Branch ("code" is generated by the server - don't send it)
# @name createCairoBranch
POST {{baseUrl}}/branch
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "فرع القاهره",
  "address": "القاهره، وسط البلد"
}

### Create Cairo Inventory
@cairoBranchId = {{createCairoBranch.response.body.data.id}}
POST {{baseUrl}}/inventory/branch/{{cairoBranchId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "مخزن القاهره",
  "address": "القاهره، المنطقة الصناعية"
}

