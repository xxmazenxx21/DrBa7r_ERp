### W2-4 Opening balance: 100 brushes at 10 -> OPENING +100
# @name w2stock
POST {{baseUrl}}/product-inventory/inventory/{{w2warehouse.response.body.$.data.id}}
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "productId": "{{w2brush.response.body.$.data.id}}",
  "quantity": 100,
  "costPrice": 10
}

### W2-5 Quotation: 10 cartons x 150, discount 10%, tax 14% -> PQ-2026-000001, netTotal 1539
# @name w2quotation
POST {{baseUrl}}/purchase-quotations
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "quotationDate": "2026-11-20",
  "validUntil": "2026-12-31",
  "supplierId": "{{w2supplier.response.body.$.data.id}}",
  "branchId": "{{w2branch.response.body.$.data.id}}",
  "warehouseId": "{{w2warehouse.response.body.$.data.id}}",
  "discountPercent": 10,
  "taxPercent": 14,
  "lines": [
    {
      "productId": "{{w2brush.response.body.$.data.id}}",
      "itemUnitId": "{{w2carton.response.body.$.data.id}}",
      "quantity": 10,
      "unitPrice": 150
    }
  ]
}

### W2-6a Quotation DRAFT -> SENT
# @name w2sent
PATCH {{baseUrl}}/purchase-quotations/{{w2quotation.response.body.$.data.id}}/status
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "status": "SENT"
}

### W2-6b Quotation SENT -> ACCEPTED
# @name w2accepted
PATCH {{baseUrl}}/purchase-quotations/{{w2quotation.response.body.$.data.id}}/status
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "status": "ACCEPTED"
}

### W2-7 Convert to a CREDIT invoice -> PI-2026-000001 DRAFT, quotation CONVERTED
# @name w2convert
POST {{baseUrl}}/purchase-quotations/{{w2quotation.response.body.$.data.id}}/convert-to-invoice
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "paymentType": "CREDIT",
  "invoiceDate": "2026-11-24"
}

###
@w2invoiceId = {{w2convert.response.body.$.data.invoice.id}}

### W2-8 Pay 500 -> paidAmount 500, remainingAmount 1039
# @name w2pay
PATCH {{baseUrl}}/purchase-invoices/{{w2invoiceId}}
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "paidAmount": 500
}

### W2-9 Post the invoice -> stock 220, average 10.6818 (PURCHASE +120 at 11.25)
# @name w2post
POST {{baseUrl}}/purchase-invoices/{{w2invoiceId}}/post
Authorization: Bearer {{w2token}}

### W2-10 Post it again -> 409 INVALID_STATUS
# @name w2postAgain
POST {{baseUrl}}/purchase-invoices/{{w2invoiceId}}/post
Authorization: Bearer {{w2token}}

### W2-11 Return 2 cartons of the invoice (linked) -> PR-2026-000001, netTotal 307.80
# @name w2return
POST {{baseUrl}}/purchase-returns
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "returnDate": "2026-11-25",
  "purchaseInvoiceId": "{{w2invoiceId}}",
  "reason": "تالف",
  "lines": [
    {
      "purchaseInvoiceLineId": "{{w2post.response.body.$.data.lines[0].id}}",
      "quantity": 2
    }
  ]
}

### W2-12 Post the return -> stock 196, average 10.6818 (PURCHASE_RETURN -24)
# @name w2returnPost
POST {{baseUrl}}/purchase-returns/{{w2return.response.body.$.data.id}}/post
Authorization: Bearer {{w2token}}

### W2-13 Cancel the invoice -> 400 (it has a POSTED return)
# @name w2cancelInvoice
POST {{baseUrl}}/purchase-invoices/{{w2invoiceId}}/cancel
Authorization: Bearer {{w2token}}

### W2-14 Cancel the return -> stock 220 (PURCHASE_RETURN_CANCEL +24)
# @name w2returnCancel
POST {{baseUrl}}/purchase-returns/{{w2return.response.body.$.data.id}}/cancel
Authorization: Bearer {{w2token}}

### W2-15 Stock count: set the stock to 218, reason "جرد" -> ADJUSTMENT -2
# @name w2adjust
PATCH {{baseUrl}}/product-inventory/{{w2stock.response.body.$.data.id}}
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "quantity": 218,
  "reason": "جرد"
}

### W2-16 Item card -> 5 movements (OPENING +100, PURCHASE +120, PURCHASE_RETURN -24, PURCHASE_RETURN_CANCEL +24, ADJUSTMENT -2), quantity 218
# @name w2card
GET {{baseUrl}}/stock-movements/item-card?productId={{w2brush.response.body.$.data.id}}&warehouseId={{w2warehouse.response.body.$.data.id}}
Authorization: Bearer {{w2token}}

### =====================================================================
### WEEK 3 - THE BIG TEST (the whole sales + stock story, top to bottom)
### =====================================================================
# Runs RIGHT AFTER "WEEK 2 - THE BIG TEST" above, on the same database (empty
# before W2-0: docker compose down -v; docker compose up -d --build).
# It starts where Week 2 ended: Maadi (مخزن المعادي) has 218 brushes @ 10.6818,
# carton = 12 pieces; it uses w2branch, w2warehouse, w2brush, w2carton.
# Send W3-0 ... W3-22 IN ORDER; the expected result is in the comment above
# each request. Every document is dated 2026-11-27.
# Final check: Maadi 218 - 60 + 12 - 24 - 1 = 145 (9 movements on the card),
#              Nasr City 0 + 24 = 24 (1 movement).

### W3-0 Login -> data.access_token (@w3token)
# @name w3login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

###
@w3token = {{w3login.response.body.$.data.access_token}}

