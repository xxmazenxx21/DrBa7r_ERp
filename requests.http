### Read All Inventory for Cairo Branch
GET {{baseUrl}}/inventory/branch/{{cairoBranchId}}
Authorization: Bearer {{token}}

### List ALL inventories (all branches), newest first
GET {{baseUrl}}/inventory
Authorization: Bearer {{token}}

### List inventories of one branch (same as /inventory/branch/:branchId)
GET {{baseUrl}}/inventory?branchId={{cairoBranchId}}
Authorization: Bearer {{token}}

### Create an employee in Cairo ("hireDate" can be "YYYY-MM-DD")
# @name createEmployee
POST {{baseUrl}}/employees/branch/{{cairoBranchId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "fullName": "أحمد محمد",
  "jobTitle": "مندوب مبيعات",
  "hireDate": "2025-01-01"
}

### List ALL employees (optionally ?branchId=...)
GET {{baseUrl}}/employees
Authorization: Bearer {{token}}

### Create a category
# @name createCategory
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "مشروبات"
}

### Create an item unit
# @name createUnit
POST {{baseUrl}}/item-unit
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "قطعة"
}

### Create a product
# itemType: "STOCK" (مخزني, default) | "SERVICE" (خدمي)
# costingMethod: "WEIGHTED_AVERAGE" (متوسط التكلفة المرجح, default)
# @name createProduct
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "بيبسي 330 مل",
  "barcode": "6221234567890",
  "categoryId": "{{createCategory.response.body.data.id}}",
  "primaryItemUnitId": "{{createUnit.response.body.data.id}}",
  "itemType": "STOCK",
  "costingMethod": "WEIGHTED_AVERAGE",
  "retailPrice": 15,
  "wholesalePrice": 12.5,
  "bulkWholesalePrice": 10
}

### Put the product in the Cairo warehouse (route is /product-inventory)
# Week 2: also writes an OPENING stock movement (رصيد افتتاحي)
# @name createStock
@cairoInventoryId = {{createCairoInventory.response.body.data.id}}
POST {{baseUrl}}/product-inventory/inventory/{{cairoInventoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "productId": "{{createProduct.response.body.data.id}}",
  "quantity": 100,
  "costPrice": 12.5
}

### Clear an employee's hire date (PATCH null clears a nullable field)
PATCH {{baseUrl}}/employees/{{createEmployee.response.body.data.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "hireDate": null
}

### Create a user linked to the employee: branchId is filled from the employee
# username: 3-30 chars, letters/digits . _ - only, no spaces
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "ahmed.sales",
  "password": "secret123",
  "role": "SALES",
  "employeeId": "{{createEmployee.response.body.data.id}}"
}

### 400: branchId differs from the employee's branch
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "ahmed.other",
  "password": "secret123",
  "role": "SALES",
  "employeeId": "{{createEmployee.response.body.data.id}}",
  "branchId": "{{createAlexBranch.response.body.data.id}}"
}

### 400: username with a space
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "ahmed ali",
  "password": "secret123",
  "role": "USER"
}

### Supplier with a NEGATIVE opening balance (the supplier owes us 500)
# supplier: + = we owe the supplier, - = the supplier owes us
# customer: + = the customer owes us, - = we owe the customer
POST {{baseUrl}}/supplier
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "مورد دفعة مقدمة",
  "openingBalance": -500
}

### 400: price with 5 decimals (max 4 for prices/quantities, 2 for money)
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "صنف تجربة",
  "categoryId": "{{createCategory.response.body.data.id}}",
  "primaryItemUnitId": "{{createUnit.response.body.data.id}}",
  "retailPrice": 12.34567,
  "wholesalePrice": 12,
  "bulkWholesalePrice": 10
}

### =====================================================================
### WEEK 2 - THE BIG TEST (the whole story, top to bottom)
### =====================================================================
# Run on an EMPTY database:
#   docker compose down -v
#   docker compose up -d --build
# then send these requests IN ORDER (W2-0 ... W2-16). The expected result is
# in the comment above each request. Final check: 100 + 120 - 24 + 24 - 2 = 218.
# (Self-contained: it does not use the Week 1 requests above.)

### W2-0 Login (admin / admin123 is created on an empty database)
# @name w2login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin123"
}

###
@w2token = {{w2login.response.body.$.data.access_token}}

### W2-1 EGP, the default currency -> isDefault true
# @name w2egp
POST {{baseUrl}}/currency
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "code": "EGP",
  "name": "جنيه مصري",
  "symbol": "ج.م",
  "isDefault": true
}

### W2-2a Branch
# @name w2branch
POST {{baseUrl}}/branch
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "name": "فرع المعادي",
  "address": "المعادي"
}

### W2-2b Warehouse in the branch
# @name w2warehouse
POST {{baseUrl}}/inventory/branch/{{w2branch.response.body.$.data.id}}
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "name": "مخزن المعادي",
  "address": "المعادي"
}

### W2-2c Category
# @name w2category
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{w2token}}

{
  "name": "أدوات العناية"
}

### W2-2d Unit: piece (قطعة)
