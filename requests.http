### Read All Inventory for Cairo Branch
GET {{baseUrl}}/inventory/branch/{{cairoBranchId}}
Authorization: Bearer {{token}}

### List ALL inventories (all branches), newest first
GET {{baseUrl}}/inventory
Authorization: Bearer {{token}}

### List inventories of one branch (same as /inventory/branch/:branchId)
GET {{baseUrl}}/inventory?branchId={{cairoBranchId}}
Authorization: Bearer {{token}}

### Create an employee in Cairo ("hireDate" can be "YYYY-MM-DD")
# @name createEmployee
POST {{baseUrl}}/employees/branch/{{cairoBranchId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "fullName": "أحمد محمد",
  "jobTitle": "مندوب مبيعات",
  "hireDate": "2025-01-01"
}

### List ALL employees (optionally ?branchId=...)
GET {{baseUrl}}/employees
Authorization: Bearer {{token}}

### Create a category
# @name createCategory
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "مشروبات"
}

### Create an item unit
# @name createUnit
POST {{baseUrl}}/item-unit
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "قطعة"
}

### Create a product
# itemType: "STOCK" (مخزني, default) | "SERVICE" (خدمي)
# costingMethod: "WEIGHTED_AVERAGE" (متوسط التكلفة المرجح, default)
# @name createProduct
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "بيبسي 330 مل",
  "barcode": "6221234567890",
  "categoryId": "{{createCategory.response.body.data.id}}",
  "primaryItemUnitId": "{{createUnit.response.body.data.id}}",
  "itemType": "STOCK",
  "costingMethod": "WEIGHTED_AVERAGE",
  "retailPrice": 15,
  "wholesalePrice": 12.5,
  "bulkWholesalePrice": 10
}

### Put the product in the Cairo warehouse (route is /product-inventory)
# Week 2: also writes an OPENING stock movement (رصيد افتتاحي)
# @name createStock
@cairoInventoryId = {{createCairoInventory.response.body.data.id}}
POST {{baseUrl}}/product-inventory/inventory/{{cairoInventoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "productId": "{{createProduct.response.body.data.id}}",
  "quantity": 100,
  "costPrice": 12.5
}

### Clear an employee's hire date (PATCH null clears a nullable field)
PATCH {{baseUrl}}/employees/{{createEmployee.response.body.data.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "hireDate": null
}

### Create a user linked to the employee: branchId is filled from the employee
# username: 3-30 chars, letters/digits . _ - only, no spaces
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "ahmed.sales",
  "password": "secret123",
  "role": "SALES",
  "employeeId": "{{createEmployee.response.body.data.id}}"
}

### 400: branchId differs from the employee's branch
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "ahmed.other",
  "password": "secret123",
  "role": "SALES",
  "employeeId": "{{createEmployee.response.body.data.id}}",
  "branchId": "{{createAlexBranch.response.body.data.id}}"
}

### 400: username with a space
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "username": "ahmed ali",
  "password": "secret123",
  "role": "USER"
}

### Supplier with a NEGATIVE opening balance (the supplier owes us 500)
# supplier: + = we owe the supplier, - = the supplier owes us
# customer: + = the customer owes us, - = we owe the customer
POST {{baseUrl}}/supplier
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "مورد دفعة مقدمة",
  "openingBalance": -500
}

### 400: price with 5 decimals (max 4 for prices/quantities, 2 for money)
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "صنف تجربة",
  "categoryId": "{{createCategory.response.body.data.id}}",
  "primaryItemUnitId": "{{createUnit.response.body.data.id}}",
  "retailPrice": 12.34567,
  "wholesalePrice": 12,
  "bulkWholesalePrice": 10
}

### ===================== Week 2 =====================

### Create EGP as the DEFAULT currency ("code": 3 capital letters, sent by you)
# @name createEgp
POST {{baseUrl}}/currency
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "EGP",
  "name": "جنيه مصري",
  "symbol": "ج.م",
  "isDefault": true
}

### Create USD (not default)
# @name createUsd
POST {{baseUrl}}/currency
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "USD",
  "name": "دولار أمريكي",
  "symbol": "$"
}

### List currencies (default first)
GET {{baseUrl}}/currency
Authorization: Bearer {{token}}

### Make USD the default -> EGP becomes isDefault false automatically
PATCH {{baseUrl}}/currency/{{createUsd.response.body.data.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "isDefault": true
}

### 400: the default currency (USD now) can't be deleted
DELETE {{baseUrl}}/currency/{{createUsd.response.body.data.id}}
Authorization: Bearer {{token}}

### Give the default back to EGP
PATCH {{baseUrl}}/currency/{{createEgp.response.body.data.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "isDefault": true
}

### Product units: brush carton = 12 pieces (primary unit is the piece)
# @name createCartonUnit
POST {{baseUrl}}/products/{{createProduct.response.body.data.id}}/units
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "itemUnitId": "<id of the carton from GET /item-unit>",
  "factor": 12,
  "retailPrice": 170
}

### All units of the product: primary (factor 1) first, then the others
GET {{baseUrl}}/products/{{createProduct.response.body.data.id}}/units
Authorization: Bearer {{token}}

### Change the factor / clear the unit price
PATCH {{baseUrl}}/product-units/{{createCartonUnit.response.body.data.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "factor": 24,
  "retailPrice": null
}

### Delete the unit (POST it again later -> restored)
DELETE {{baseUrl}}/product-units/{{createCartonUnit.response.body.data.id}}
Authorization: Bearer {{token}}

### Stock count: Cairo stock 100 -> 90. "reason" is REQUIRED when quantity/cost changes
# Writes an ADJUSTMENT movement of -10
PATCH {{baseUrl}}/product-inventory/{{createStock.response.body.data.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantity": 90,
  "reason": "جرد"
}

### Item card (كارت الصنف): OPENING +100, then ADJUSTMENT -10 (جرد), balance 90
GET {{baseUrl}}/stock-movements/item-card?productId={{createProduct.response.body.data.id}}&warehouseId={{cairoInventoryId}}
Authorization: Bearer {{token}}

### All movements, newest first (filters: productId, warehouseId, type, dateFrom, dateTo; paginated)
GET {{baseUrl}}/stock-movements?type=ADJUSTMENT&page=1&pageSize=20
Authorization: Bearer {{token}}

### ---------- Purchase quotations (Task 6) ----------

### A supplier for the purchase documents
# @name createNileSupplier
POST {{baseUrl}}/supplier
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "النيل"
}

### Quotation: 10 cartons x 150, discount 10%, tax 14%
# -> subTotal 1500, discountValue 150, taxValue 189, netTotal 1539 (code PQ-<year>-000001, DRAFT)
# itemUnitId: the carton unit of the product (createCartonUnit above, factor 12)
# @name createQuotation
POST {{baseUrl}}/purchase-quotations
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quotationDate": "2026-11-20",
  "validUntil": "2026-12-31",
  "supplierId": "{{createNileSupplier.response.body.data.id}}",
  "branchId": "{{cairoBranchId}}",
  "warehouseId": "{{cairoInventoryId}}",
  "discountPercent": 10,
  "taxPercent": 14,
  "lines": [
    {
      "productId": "{{createProduct.response.body.data.id}}",
      "itemUnitId": "{{createCartonUnit.response.body.data.itemUnitId}}",
      "quantity": 10,
      "unitPrice": 150
    }
  ]
}

### List quotations (paginated; filters supplierId, branchId, status, dateFrom, dateTo, search)
GET {{baseUrl}}/purchase-quotations?status=DRAFT&page=1&pageSize=20
Authorization: Bearer {{token}}

### One quotation (lines + isExpired)
GET {{baseUrl}}/purchase-quotations/{{createQuotation.response.body.data.id}}
Authorization: Bearer {{token}}

### Edit (DRAFT / SENT only): "lines" would REPLACE all lines
PATCH {{baseUrl}}/purchase-quotations/{{createQuotation.response.body.data.id}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "notes": "السعر شامل التوصيل"
}

### DRAFT -> SENT
PATCH {{baseUrl}}/purchase-quotations/{{createQuotation.response.body.data.id}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "SENT"
}

### SENT -> ACCEPTED
PATCH {{baseUrl}}/purchase-quotations/{{createQuotation.response.body.data.id}}/status
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "ACCEPTED"
}

### Convert the ACCEPTED quotation into a DRAFT purchase invoice (quotation -> CONVERTED)
# warehouseId: only needed when the quotation has none
POST {{baseUrl}}/purchase-quotations/{{createQuotation.response.body.data.id}}/convert-to-invoice
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "paymentType": "CREDIT",
  "invoiceDate": "2026-11-25"
}

### ---------- Purchase invoices (Task 7) ----------

### Invoice: 10 cartons x 150, discount 10%, tax 14%, CREDIT paid 500
# -> net 1539, remaining 1039 (DRAFT, code PI-<year>-000001). No currencyId = the default currency.
# @name createInvoice
POST {{baseUrl}}/purchase-invoices
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "invoiceDate": "2026-11-24",
  "dueDate": "2026-12-24",
  "supplierInvoiceNumber": "NILE-778",
  "paymentType": "CREDIT",
  "supplierId": "{{createNileSupplier.response.body.data.id}}",
  "branchId": "{{cairoBranchId}}",
  "warehouseId": "{{cairoInventoryId}}",
  "discountPercent": 10,
  "taxPercent": 14,
  "paidAmount": 500,
  "lines": [
    {
      "productId": "{{createProduct.response.body.data.id}}",
      "itemUnitId": "{{createCartonUnit.response.body.data.itemUnitId}}",
      "quantity": 10,
      "unitCost": 150
    }
  ]
}

### Post (ترحيل): stock + 120 pieces at 11.25 each (PURCHASE movement)
POST {{baseUrl}}/purchase-invoices/{{createInvoice.response.body.data.id}}/post
Authorization: Bearer {{token}}

### Post again -> 409 INVALID_STATUS
POST {{baseUrl}}/purchase-invoices/{{createInvoice.response.body.data.id}}/post
Authorization: Bearer {{token}}

### What can still be returned, per line
GET {{baseUrl}}/purchase-invoices/{{createInvoice.response.body.data.id}}/returnable
Authorization: Bearer {{token}}

### List invoices (paginated; filters supplierId, branchId, warehouseId, status, paymentType, dateFrom, dateTo, search)
GET {{baseUrl}}/purchase-invoices?status=POSTED&page=1&pageSize=20
Authorization: Bearer {{token}}

### Cancel (إلغاء): stock - 120 again (PURCHASE_CANCEL). 400 INSUFFICIENT_STOCK if the goods were used
POST {{baseUrl}}/purchase-invoices/{{createInvoice.response.body.data.id}}/cancel
Authorization: Bearer {{token}}
