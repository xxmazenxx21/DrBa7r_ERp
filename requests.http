POST {{baseUrl}}/sales-returns
Content-Type: application/json
Authorization: Bearer {{w3token}}

{
  "returnDate": "2026-11-27",
  "reason": "تالف",
  "salesInvoiceId": "{{w3invoiceId}}",
  "lines": [
