/// STOCK = مخزني (tracked in warehouses), SERVICE = خدمي (no stock)
enum ItemType {
  STOCK
  SERVICE
}

/// WEIGHTED_AVERAGE = متوسط التكلفة المرجح
enum CostingMethod {
  WEIGHTED_AVERAGE
}

model Product {
  id                     String                  @id @default(cuid())
  code                   String                  @unique
  barcode                String?                 @unique
  name                   String
  categoryId             String
  category               Categories              @relation(fields: [categoryId], references: [id])
  primaryItemUnitId      String
  primaryItemUnit        ItemUnit                @relation(fields: [primaryItemUnitId], references: [id])
  itemType               ItemType                @default(STOCK)
  costingMethod          CostingMethod           @default(WEIGHTED_AVERAGE)
  retailPrice            Decimal                 @db.Decimal(18, 4)
  wholesalePrice         Decimal                 @db.Decimal(18, 4)
  bulkWholesalePrice     Decimal                 @db.Decimal(18, 4)
  reorderLimit           Decimal                 @default(0) @db.Decimal(18, 4)
  hasExpiryDate          Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  productInventories     ProductInventory[]
  units                  ProductUnit[]
  stockMovements         StockMovement[]
  purchaseQuotationLines PurchaseQuotationLine[]
  purchaseInvoiceLines   PurchaseInvoiceLine[]
  purchaseReturnLines    PurchaseReturnLine[]
  salesQuotationLines    SalesQuotationLine[]
  salesInvoiceLines      SalesInvoiceLine[]
  salesReturnLines       SalesReturnLine[]
  stockTransferLines     StockTransferLine[]
  stockCountLines        StockCountLine[]
}

model ProductInventory {
  id          String    @id @default(cuid())
  productId   String
  inventoryId String
  product     Product   @relation(fields: [productId], references: [id])
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(18, 4)
  costPrice   Decimal   @default(0) @db.Decimal(18, 4)
  deletedAt   DateTime?

  @@unique([productId, inventoryId])
}
