enum Role {
  SUPERADMIN
  ADMIN
  ACCOUNTANT
  SALES
  USER
}

model User {
  id       String  @id @default(cuid())
  username String  @unique
  password String
  email    String? @unique

  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  role Role @default(USER)

  lastLoginDate DateTime?

  postedInvoices          PurchaseInvoice[]   @relation("PostedInvoices")
  createdInvoices         PurchaseInvoice[]   @relation("CreatedInvoices")
  modifiedInvoices        PurchaseInvoice[]   @relation("ModifiedInvoices")
  cancelledInvoices       PurchaseInvoice[]   @relation("CancelledInvoices")
  createdReturns          PurchaseReturn[]    @relation("CreatedReturns")
  modifiedReturns         PurchaseReturn[]    @relation("ModifiedReturns")
  postedReturns           PurchaseReturn[]    @relation("PostedReturns")
  cancelledReturns        PurchaseReturn[]    @relation("CancelledReturns")
  createdSalesQuotations  SalesQuotation[]    @relation("CreatedSalesQuotations")
  modifiedSalesQuotations SalesQuotation[]    @relation("ModifiedSalesQuotations")
  createdSalesInvoices    SalesInvoice[]      @relation("CreatedSalesInvoices")
  modifiedSalesInvoices   SalesInvoice[]      @relation("ModifiedSalesInvoices")
  postedSalesInvoices     SalesInvoice[]      @relation("PostedSalesInvoices")
  cancelledSalesInvoices  SalesInvoice[]      @relation("CancelledSalesInvoices")
  stockMovements          StockMovement[]
  createdQuotations       PurchaseQuotation[] @relation("CreatedQuotations")
  modifiedQuotations      PurchaseQuotation[] @relation("ModifiedQuotations")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
