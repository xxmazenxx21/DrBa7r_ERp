# Copy to .env to override the docker-compose defaults (all optional).
# NOTE: for local (non-Docker) dev you also need DATABASE_URL here.

# Local dev only (npm run start:dev):
# DATABASE_URL=postgresql://erp:erp_password@localhost:5433/erp?schema=public

POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_password
POSTGRES_DB=erp
JWT_SECRET=change_me_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
API_PORT=3000
DB_PORT=5433
